# Common defaults for KaawayAn acoustic nodes (ESP32-S3)
CONFIG_IDF_TARGET="esp32s3"

# CPU Frequency: 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Console on UART0 only; USB Serial/JTAG console OFF so no log output on USB data port
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n

# Default log level WARN to keep UART quiet
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2

# PSRAM / SPIRAM disabled on both boards
CONFIG_SPIRAM=n

# Wi-Fi and Bluetooth disabled
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n

# FreeRTOS ticks 1000 Hz for precise 1 ms delays
CONFIG_FREERTOS_HZ=1000

# KaawayAn protocol defaults
CONFIG_KAAWAYAN_RAMP_MODE=y
CONFIG_KAAWAYAN_USB_BACKEND_JTAG=y
